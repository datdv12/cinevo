# Sao chép file này thành .env (cùng thư mục) rồi chỉnh nếu cần. KHÔNG commit file .env.

# development (mặc định) hoặc production. Ở production, cấu hình yếu sẽ bị từ chối khởi động.
APP_ENV=development

# BẮT BUỘC ở production, tối thiểu 32 ký tự. Tạo khóa:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Ở development nếu để trống, hệ thống tự sinh khóa ngẫu nhiên lưu ở backend/database/.dev_secret_key
SECRET_KEY=
JWT_EXPIRES_HOURS=24

# Mặc định dùng SQLite tại backend/database/cinevo.db. Muốn chuyển PostgreSQL thì mở dòng dưới
# (và chạy: pip install psycopg2-binary):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/cinevo

CORS_ORIGINS=http://localhost:5173

# Chỉ lắng nghe localhost. Debug sẽ TỰ TẮT nếu HOST khác localhost hoặc APP_ENV=production.
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=true

# OTP (chỉ có tác dụng ở development): mã cố định + hiện gợi ý trên giao diện.
# Ở production luôn dùng mã ngẫu nhiên, không trả mã ra API.
MOCK_OTP_CODE=123456
OTP_DEBUG_HINT=true

# Tính năng AI: TẠM TẮT theo lộ trình (chưa tích hợp AI). Code AI vẫn được giữ lại.
# Chỉ đổi thành true khi đã được cho phép bắt đầu giai đoạn AI.
FEATURE_AI=false

# Giới hạn số lần thử đăng nhập/OTP/đăng ký. Chỉ tắt khi chạy test.
RATELIMIT_ENABLED=true
